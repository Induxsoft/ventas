#include "dkli.dkh"
#!
module ""
{
    do errordet(@false)
    
    switch @@(params,"$_view")
    {
        case "process"
        {
            point @update to procesar
            break
        }
        case "process-docs"
        {
            point @create to procesarSeleccionados
            break
        }
    }
}